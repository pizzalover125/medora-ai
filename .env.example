# Get a key at https://ai.hackclub.com/dashboard
HACKCLUB_API_KEY=hc_your_key_here

# Chat model (any id from https://ai.hackclub.com/proxy/v1/models)
HACKCLUB_MODEL=google/gemini-3.8-flash

# On-device Whisper model: tiny.en | base.en | small.en | medium.en | large-v3
# small.en is the sweet spot for accuracy vs. speed on a laptop CPU.
WHISPER_MODEL=small.en
WHISPER_COMPUTE=int8

# Web search via Exa. The model decides when to use it.
EXA_SEARCH=1
EXA_RESULTS=4
EXA_MAX_ROUNDS=2

# Where to listen. 127.0.0.1 is this machine only; 0.0.0.0 (or ./run.sh --lan)
# also serves the contact pages to phones on the same wifi.
HOST=127.0.0.1
PORT=5001

# SSL=1 (or ./run.sh --https) serves over TLS with a certificate this machine
# signs itself. Video calls from a phone need it - no browser opens a camera
# on a page that is not secure.
SSL=0

# Video calls go straight between the two browsers. On one wifi they find each
# other on their own. A network that keeps its devices apart needs a relay:
# put a TURN server here and calls will fall back to it. Nothing is relayed
# while TURN_URL is empty.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── Netlify only ───────────────────────────────────────────────────────────
# The passcode each of the senior's devices enters once.
SENIOR_PASSCODE=
SESSION_SECRET=
# Web Push, so calls and messages arrive with the page closed:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.netlify.app
# A TURN relay for calls across strict networks - or a Metered.ca key instead.
METERED_DOMAIN=
METERED_API_KEY=
